rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LOCAL EMULATOR PREVIEW ONLY. Production rules remain in firestore.rules.
    // Public reads are scoped to this development projection. Browsers cannot
    // create, edit, or delete any record, including Shelf data.
    function isPreviewCollection(collectionId) {
      return collectionId in [
        'appPreviewRemedies',
        'appPreviewGoals',
        'appPreviewTraditions',
        'appPreviewSources',
        'appPreviewStudies',
        'appPreviewReleases'
      ];
    }
    match /{collectionId}/{documentId} {
      allow read: if isPreviewCollection(collectionId);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://root-remedy.example/schemas/dataset-1.0.0.json",
  "title": "Root & Remedy canonical dataset v1",
  "description": "Research-data structure. Structural validation does not establish medical accuracy or clinical approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "remedies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/remedy"
      },
      "minItems": 20,
      "maxItems": 20
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingredient"
      },
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      },
      "minItems": 1
    },
    "evidenceAssessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceAssessment"
      },
      "minItems": 20
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/study"
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "screeningLog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screening"
      },
      "minItems": 20
    }
  },
  "required": [
    "metadata",
    "remedies",
    "ingredients",
    "conditions",
    "evidenceAssessments",
    "studies",
    "sources",
    "screeningLog"
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "datasetId": {
          "const": "root-remedy"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "datasetVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "researchDate": {
          "type": "string",
          "format": "date"
        },
        "locale": {
          "const": "en-US"
        },
        "intendedAudience": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "medicalReviewStatus": {
          "const": "not_reviewed"
        },
        "createdBy": {
          "const": "AI-assisted source extraction"
        },
        "sourcePolicy": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "datasetId",
        "title",
        "schemaVersion",
        "datasetVersion",
        "researchDate",
        "locale",
        "intendedAudience",
        "description",
        "medicalReviewStatus",
        "createdBy",
        "sourcePolicy",
        "limitations"
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "supports",
            "qualifies",
            "contradicts"
          ]
        }
      },
      "required": [
        "sourceId",
        "locator",
        "support"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "category": {
          "enum": [
            "identity",
            "benefit",
            "limitation",
            "safety",
            "preparation",
            "culture",
            "nutrition"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "minItems": 1
        },
        "verificationStatus": {
          "const": "source_checked"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "category",
        "text",
        "citations",
        "verificationStatus",
        "verifiedAt"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "government_summary",
            "clinical_guideline",
            "systematic_review",
            "randomized_trial",
            "clinical_study",
            "regulatory_monograph",
            "botanical_reference",
            "cultural_reference",
            "nutrition_reference"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pmid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "datePrecision": {
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ]
        },
        "accessedAt": {
          "type": "string",
          "format": "date"
        },
        "accessLevel": {
          "enum": [
            "full_text",
            "abstract",
            "summary"
          ]
        },
        "retractionCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "not_checked",
                "checked_no_notice",
                "notice_found"
              ]
            },
            "checkedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "checkedAt"
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "authors",
        "publisher",
        "sourceType",
        "url",
        "doi",
        "pmid",
        "publishedDate",
        "datePrecision",
        "accessedAt",
        "accessLevel",
        "retractionCheck",
        "notes"
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scientificName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "partOrForm": {
          "type": "string",
          "minLength": 1
        },
        "identitySourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allergenNotes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "scientificName",
        "aliases",
        "partOrForm",
        "identitySourceIds",
        "allergenNotes"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "symptom",
            "diagnosed_condition",
            "prevention_goal"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "aliases"
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "whole_food",
            "food_preparation",
            "standardized_product",
            "topical_product",
            "saline_product"
          ]
        },
        "route": {
          "enum": [
            "oral",
            "topical",
            "nasal"
          ]
        },
        "ingredientIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "formulationDescription": {
          "type": "string",
          "minLength": 1
        },
        "formulationClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "guidedUse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "available",
                "not_provided"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "claimIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                      "maxLength": 120
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "timerSeconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "order",
                  "text",
                  "claimIds",
                  "timerSeconds"
                ]
              },
              "minItems": 0
            },
            "totalTimeMinutes": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reason",
            "steps",
            "totalTimeMinutes"
          ]
        },
        "studyDoseIsNotInstruction": {
          "const": true
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "route",
        "ingredientIds",
        "formulationDescription",
        "formulationClaimIds",
        "guidedUse",
        "studyDoseIsNotInstruction"
      ]
    },
    "culture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "associationType": {
          "enum": [
            "botanical_native_range",
            "documented_traditional_use",
            "historical_preparation",
            "modern_clinical_use",
            "unknown"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "countryCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "communities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "narrativeClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "originStatus": {
          "enum": [
            "documented_association",
            "multiple_regions",
            "uncertain",
            "not_established"
          ]
        },
        "mapAnchor": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "precision": {
                  "const": "region"
                },
                "isRepresentative": {
                  "const": true
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 120
                }
              },
              "required": [
                "latitude",
                "longitude",
                "precision",
                "isRepresentative",
                "sourceId"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "associationType",
        "regions",
        "countryCodes",
        "communities",
        "narrativeClaimIds",
        "originStatus",
        "mapAnchor",
        "uncertainty"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safetyScore": {
          "type": "null"
        },
        "scoreStatus": {
          "const": "not_defined"
        },
        "scoreMethodVersion": {
          "type": "null"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "scopeClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 120
              },
              "type": {
                "enum": [
                  "adverse_effect",
                  "contraindication",
                  "interaction",
                  "population_caution",
                  "handling",
                  "seek_care"
                ]
              },
              "severity": {
                "enum": [
                  "informational",
                  "caution",
                  "avoid",
                  "urgent"
                ]
              },
              "population": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 120
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "evidenceBasis": {
                "enum": [
                  "documented",
                  "potential",
                  "not_established"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "severity",
              "population",
              "claimIds",
              "evidenceBasis"
            ]
          },
          "minItems": 1
        },
        "knowledgeGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 120
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "text",
              "claimIds"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "safetyScore",
        "scoreStatus",
        "scoreMethodVersion",
        "scope",
        "scopeClaimIds",
        "items",
        "knowledgeGaps"
      ]
    },
    "remedy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "remedyType": {
          "enum": [
            "food",
            "fiber",
            "botanical_product",
            "topical",
            "saline",
            "mineral_product"
          ]
        },
        "summaryClaimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ingredientIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preparations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preparation"
          },
          "minItems": 1
        },
        "culturalContexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/culture"
          },
          "minItems": 1
        },
        "safety": {
          "$ref": "#/$defs/safety"
        },
        "evidenceAssessmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 1
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "searchTerms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "image": {
              "type": "null"
            }
          },
          "required": [
            "searchTerms",
            "tags",
            "image"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "editorialStatus": {
              "const": "research_complete"
            },
            "medicalReviewStatus": {
              "const": "not_reviewed"
            },
            "reviewedAt": {
              "type": "string",
              "format": "date"
            },
            "reviewedBy": {
              "const": "AI-assisted source extraction"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "editorialStatus",
            "medicalReviewStatus",
            "reviewedAt",
            "reviewedBy",
            "limitations"
          ]
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "aliases",
        "remedyType",
        "summaryClaimIds",
        "ingredientIds",
        "conditionIds",
        "preparations",
        "culturalContexts",
        "safety",
        "evidenceAssessmentIds",
        "claims",
        "display",
        "review",
        "schemaVersion",
        "contentRevision"
      ]
    },
    "evidenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
